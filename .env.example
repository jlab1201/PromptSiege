# PromptSiege environment configuration
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real API keys.
#
# Loaded at server startup by ui/judge.py:load_env_file(), read in
# ui/server.py to seed the judge LLM's default config. Neither variable is
# required to run a scan — only the judge (LLM scoring) pass needs one.

# Anthropic API key for the judge LLM pass. If set (and OPENAI_API_KEY is
# not), the judge defaults to claude-haiku-4-5-20251001 via
# https://api.anthropic.com/v1.
ANTHROPIC_API_KEY=

# OpenAI API key for the judge LLM pass. Takes priority over
# ANTHROPIC_API_KEY if both are set. Defaults the judge to gpt-4o-mini via
# https://api.openai.com/v1.
OPENAI_API_KEY=

# You can also set/clear the judge's key at runtime from the UI
# (POST /api/judge/config) — it persists back into this file. The judge
# also accepts any OpenAI-compatible provider by base_url, configurable
# from the same endpoint.
